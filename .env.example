# ==========================================
# Loyalty Rewards System - Environment Setup
# ==========================================
# Rename this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.

# Application Configuration
APP_ENV=development
APP_URL=http://localhost/loyalty_rewards

# Database Configuration (MySQL)
# Default settings for XAMPP local development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loyalty_rewards
DB_USER=root
DB_PASS=

# Security & Authentication
# The password required to access the Factory Owner Dashboard (admin.php)
ADMIN_DASHBOARD_PASS=factory2026

# Fraud Prevention Settings
# Number of failed attempts before an IP is locked out
MAX_FAILED_ATTEMPTS=5
# Lockout duration in seconds (900s = 15 minutes)
LOCKOUT_DURATION=900